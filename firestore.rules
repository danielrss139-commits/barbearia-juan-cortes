// =====================================================================
// Barbearia Juan Cortes — regras do Firestore (PRODUÇÃO)
// ---------------------------------------------------------------------
// Quem é o barbeiro: conta do Firebase Auth (e-mail/senha) cujo uid tem
// um documento em admins/{uid} (criado pelo Console, nunca pelo app).
// Opcional: cole o uid em UID_FIXO abaixo (funciona mesmo sem admins/).
//
// Público (sem login):
//   - lê servicos, config/loja e slots (slots NÃO têm dado pessoal);
//   - só CRIA agendamento, junto (mesmo batch) com os slots de 15 min
//     que ele ocupa. Slot só pode ser criado se ainda não existe, então
//     o segundo cliente no mesmo horário é recusado pelo servidor.
//   - nunca lê, lista, altera ou apaga agendamentos; nunca altera/apaga slots.
// Fuso: data/hora do agendamento é horário de Salvador (UTC-3, sem
// horário de verão desde 2019).
// Tudo que não está liberado aqui é negado.
// =====================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- quem é quem ----------
    function uidFixo() { return 'COLE_AQUI_O_UID_DO_JUAN'; }   // opcional
    function barbeiro() {
      return request.auth != null
        && (request.auth.uid == uidFixo()
            || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // ---------- utilidades ----------
    function caminho(col, id) { return /databases/$(database)/documents/$(col)/$(id); }
    function slotId(data, minuto) { return data + '_' + string(minuto); }
    function txt(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function dataOk(v) { return v is string && v.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$'); }
    function horaOk(v) { return v is string && v.matches('^[0-2][0-9]:[0-5][0-9]$'); }
    function dinheiro(v) { return (v is int || v is float) && v >= 0 && v <= 100000; }
    function idOk(v) { return v is string && v.matches('^[A-Za-z0-9_-]{1,60}$'); }
    // 'AAAA-MM-DD' -> timestamp da meia-noite (UTC) daquele dia
    function diaTs(data) {
      let p = data.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2]));
    }
    // agora no relógio de Salvador (UTC-3), como timestamp "local"
    function agoraLocal() { return request.time - duration.value(3, 'h'); }

    // ---------- admins: só leitura (o próprio barbeiro); escrita só pelo Console/Admin SDK ----------
    match /admins/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || barbeiro());
      allow list: if barbeiro();
      allow write: if false;
    }

    // ---------- catálogo ----------
    function servicoValido(d) {
      return d.keys().hasOnly(['nome', 'preco', 'duracao', 'ordem', 'ativo'])
        && d.keys().hasAll(['nome', 'preco', 'duracao'])
        && txt(d.nome, 1, 60)
        && dinheiro(d.preco)
        && d.duracao is int && d.duracao >= 5 && d.duracao <= 240
        && (!('ordem' in d) || (d.ordem is int && d.ordem >= 0 && d.ordem <= 1000))
        && (!('ativo' in d) || d.ativo is bool);
    }
    match /servicos/{id} {
      allow read: if true;
      allow create, update: if barbeiro() && idOk(id) && servicoValido(request.resource.data);
      allow delete: if barbeiro();
    }

    // ---------- horário de funcionamento ----------
    function configValida(d) {
      return d.keys().hasOnly(['horarios', 'almoco', 'folgas', 'intervalo'])
        && d.keys().hasAll(['horarios', 'intervalo'])
        && d.horarios is map && d.horarios.keys().hasOnly(['0', '1', '2', '3', '4', '5', '6'])
        && (!('almoco' in d) || d.almoco == null || (d.almoco is list && d.almoco.size() == 2))
        && (!('folgas' in d) || (d.folgas is list && d.folgas.size() <= 400))
        && d.intervalo is int && d.intervalo >= 5 && d.intervalo <= 240;
    }
    match /config/{doc} {
      allow read: if doc == 'loja';
      allow write: if barbeiro() && doc == 'loja' && configValida(request.resource.data);
    }

    // ---------- agendamentos (PRIVADO) ----------
    // Criação pública: tudo conferido contra servicos/{id} e config/loja,
    // e o primeiro slot do horário precisa ser criado no MESMO batch
    // apontando para este agendamento (cada slot aponta para o seguinte,
    // até cobrir inicio..fim — ver /slots).
    function agendamentoPublicoValido(agId, d) {
      let svc = get(caminho('servicos', d.servicoId)).data;
      let cfg = get(caminho('config', 'loja')).data;
      let dia = diaTs(d.data);
      let faixa = cfg.horarios[string(dia.dayOfWeek() % 7)];   // dayOfWeek: seg=1..dom=7 -> dom=0
      let almoco = cfg.get('almoco', null);
      let primeiro = getAfter(caminho('slots', slotId(d.data, d.inicio)));
      return d.keys().hasOnly(['nome', 'telefone', 'servicoId', 'servicoNome', 'preco', 'duracao',
                               'data', 'inicio', 'fim', 'status', 'criadoEm'])
        && d.keys().hasAll(['nome', 'telefone', 'servicoId', 'servicoNome', 'preco', 'duracao',
                            'data', 'inicio', 'fim', 'status', 'criadoEm'])
        && txt(d.nome, 2, 60)
        && d.telefone is string && d.telefone.matches('^[0-9]{10,13}$')
        && idOk(d.servicoId)
        && dataOk(d.data)
        && d.inicio is int && d.inicio >= 0 && d.inicio < 1440 && d.inicio % 15 == 0
        && d.status == 'marcado'
        && d.criadoEm == request.time
        // catálogo: serviço existe, está ativo, e preço/duração/nome são os dele
        && exists(caminho('servicos', d.servicoId))
        && svc.get('ativo', true) == true
        && d.servicoNome == svc.nome
        && d.preco == svc.preco
        && d.duracao == svc.duracao
        && d.fim == d.inicio + d.duracao
        // dia: de hoje até +60 dias, e o horário ainda não passou
        && dia >= agoraLocal().date()
        && dia <= agoraLocal().date() + duration.value(60, 'd')
        && dia + duration.value(d.inicio, 'm') > agoraLocal()
        // loja aberta nesse dia e nesse horário, fora do almoço e das folgas
        && faixa != null && faixa is list && faixa.size() == 2
        && d.inicio >= faixa[0] && d.fim <= faixa[1]
        && (almoco == null || !(d.inicio < almoco[1] && almoco[0] < d.fim))
        && !(d.data in cfg.get('folgas', []))
        // trava do horário: 1º slot criado agora, apontando para este agendamento
        && primeiro != null && primeiro.data.agId == agId;
    }
    function agendamentoBarbeiroValido(d) {
      return d.keys().hasOnly(['nome', 'telefone', 'servicoId', 'servicoNome', 'preco', 'duracao',
                               'data', 'inicio', 'fim', 'status', 'origem', 'criadoEm', 'atualizadoEm'])
        && txt(d.nome, 1, 60)
        && (!('telefone' in d) || (d.telefone is string && d.telefone.size() <= 20))
        && (!('servicoNome' in d) || txt(d.servicoNome, 0, 60))
        && (!('servicoId' in d) || txt(d.servicoId, 0, 60))
        && dataOk(d.data)
        && d.inicio is int && d.fim is int
        && d.status in ['marcado', 'atendido', 'faltou', 'cancelado']
        && (!('origem' in d) || d.origem in ['online', 'painel']);
    }
    match /agendamentos/{agId} {
      allow read: if barbeiro();
      allow create: if (barbeiro() && agendamentoBarbeiroValido(request.resource.data))
                    || (request.auth == null && idOk(agId)
                        && agendamentoPublicoValido(agId, request.resource.data));
      allow update: if barbeiro() && agendamentoBarbeiroValido(request.resource.data);
      allow delete: if barbeiro();
    }

    // ---------- slots (PÚBLICO, sem dado pessoal) ----------
    // Um doc por bloco de 15 min: id "AAAA-MM-DD_minuto", { agId, data, minuto, criadoEm }.
    // create só acontece se o doc NÃO existe (se existe, é update = negado),
    // por isso dois clientes nunca ficam com o mesmo bloco.
    function slotPublicoValido(id, d) {
      let ag = getAfter(caminho('agendamentos', d.agId));
      return d.keys().hasOnly(['agId', 'data', 'minuto', 'criadoEm'])
        && d.keys().hasAll(['agId', 'data', 'minuto', 'criadoEm'])
        && idOk(d.agId)
        && dataOk(d.data)
        && d.minuto is int && d.minuto >= 0 && d.minuto < 1440 && d.minuto % 15 == 0
        && id == slotId(d.data, d.minuto)
        && d.criadoEm == request.time
        // o agendamento dono existe depois deste batch e cobre este bloco
        && ag != null
        && ag.data.data == d.data
        && ag.data.status == 'marcado'
        && d.minuto >= ag.data.inicio && d.minuto < ag.data.fim
        // corrente: o próximo bloco (se ainda dentro do horário) também é criado para o mesmo agendamento
        && (d.minuto + 15 >= ag.data.fim
            || getAfter(caminho('slots', slotId(d.data, d.minuto + 15))).data.agId == d.agId);
    }
    match /slots/{id} {
      allow get, list: if true;
      allow create: if (barbeiro() && idOk(request.resource.data.agId) && dataOk(request.resource.data.data)
                        && request.resource.data.minuto is int)
                    || (request.auth == null && slotPublicoValido(id, request.resource.data));
      allow update: if false;            // nunca: trava é criar/apagar
      allow delete: if barbeiro();
    }

    // ---------- caixa: só o barbeiro ----------
    function lancamentoValido(d) {
      return d.keys().hasOnly(['agendamentoId', 'data', 'hora', 'descricao', 'valor', 'criadoEm'])
        && dataOk(d.data)
        && (!('hora' in d) || horaOk(d.hora))
        && txt(d.descricao, 1, 120)
        && dinheiro(d.valor)
        && (!('agendamentoId' in d) || d.agendamentoId == null || idOk(d.agendamentoId));
    }
    match /cortes/{id} {
      allow read, delete: if barbeiro();
      allow create, update: if barbeiro() && idOk(id) && lancamentoValido(request.resource.data);
    }
    match /saidas/{id} {
      allow read, delete: if barbeiro();
      allow create, update: if barbeiro() && idOk(id) && lancamentoValido(request.resource.data);
    }

    // Tokens de push (FCM) do celular do barbeiro (para a futura Cloud Function)
    match /tokens/{token} {
      allow read, delete: if barbeiro();
      allow create, update: if barbeiro() && token.size() <= 300
        && request.resource.data.keys().hasOnly(['uid', 'criadoEm', 'plataforma']);
    }

    // Qualquer outra coisa: fechado
    match /{doc=**} { allow read, write: if false; }
  }
}
